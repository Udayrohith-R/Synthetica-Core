# Exa neural search
EXA_API_KEY=

# Neo4j knowledge graph
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# LLM providers (at least one required for claim extraction / arbitration)
GROQ_API_KEY=
TOGETHER_API_KEY=

# Module 2 — model cascade
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL_FAST=llama-3.1-8b-instant
LLM_MODEL_DENSE=llama-3.3-70b-versatile

# Module 5 — deep arbitration
ARBITRATION_BASE_URL=https://api.groq.com/openai/v1
ARBITRATION_MODEL=llama-3.3-70b-versatile

# Module 1 — Matryoshka projection dims
MATRYOSHKA_DIMS=64,128,256,768

# Module 4 — entropy gate & CAMMR
ENTROPY_THRESHOLD=0.55
CAMMR_LAMBDA=0.7

# Cooked research path — latency / relevance
RESEARCH_TOP_N=4
RESEARCH_EXTRACT_DOCS=3
RESEARCH_MAX_CHARS=4000
RESEARCH_MIN_RELEVANCE=0.55
CLAIM_CACHE_TTL_SECONDS=3600

# Application
APP_NAME=Synthetica-Core
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
